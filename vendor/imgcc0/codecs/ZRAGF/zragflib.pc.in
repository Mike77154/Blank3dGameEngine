prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: zragflib
Description: Small C compression library with native and zlib-like APIs
Version: @PROJECT_VERSION@
Libs: -L${libdir} -lzragflib
Cflags: -I${includedir}
