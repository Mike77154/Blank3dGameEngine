CC ?= gcc
CFLAGS ?= -std=c89 -Wall -Wextra -pedantic -Werror -O2
CPPFLAGS ?= -Iinclude
BUILD_DIR := build-mingw
LIB_OBJ := $(BUILD_DIR)/gproj2d89.o
TEST_EXE := $(BUILD_DIR)/test_gproj2d89.exe
DEMO_EXE := $(BUILD_DIR)/demo_svg.exe

.PHONY: all test audit clean

all: $(LIB_OBJ) $(TEST_EXE) $(DEMO_EXE)

$(BUILD_DIR):
	mkdir -p $(BUILD_DIR)

$(LIB_OBJ): src/gproj2d89.c include/gproj2d89.h | $(BUILD_DIR)
	$(CC) $(CFLAGS) $(CPPFLAGS) -c src/gproj2d89.c -o $@

$(TEST_EXE): src/gproj2d89.c tests/test_gproj2d89.c include/gproj2d89.h | $(BUILD_DIR)
	$(CC) $(CFLAGS) $(CPPFLAGS) src/gproj2d89.c tests/test_gproj2d89.c -o $@

$(DEMO_EXE): src/gproj2d89.c examples/demo_svg.c include/gproj2d89.h | $(BUILD_DIR)
	$(CC) $(CFLAGS) $(CPPFLAGS) src/gproj2d89.c examples/demo_svg.c -o $@

test: $(TEST_EXE)
	./$(TEST_EXE)

audit:
	./tests/static_audit.sh

clean:
	rm -rf $(BUILD_DIR)
