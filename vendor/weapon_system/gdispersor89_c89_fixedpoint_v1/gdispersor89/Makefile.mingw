CC = gcc
CFLAGS = -std=c89 -pedantic -Wall -Wextra -O2

all: demo_gdispersor89.exe

test: test_gdispersor89.exe

test_gdispersor89.exe: src/gdispersor89.c tests/test_gdispersor89.c
	$(CC) $(CFLAGS) -Isrc src/gdispersor89.c tests/test_gdispersor89.c -o $@

demo_gdispersor89.exe: src/gdispersor89.c demo/demo_gdispersor89.c
	$(CC) $(CFLAGS) -Isrc src/gdispersor89.c demo/demo_gdispersor89.c -o $@

clean:
	del /Q demo_gdispersor89.exe 2>NUL || exit 0
