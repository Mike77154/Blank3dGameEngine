CC ?= gcc
CFLAGS ?= -std=gnu89 -Wall -Wextra -pedantic -O2
INCLUDES = -Iinclude
SRC = src/w3d89.c src/w3d89_arena.c

all: test_world3d89 demo_open_world demo_interior_portals

test_world3d89: $(SRC) tests/test_world3d89.c
	$(CC) $(CFLAGS) $(INCLUDES) $(SRC) tests/test_world3d89.c -o test_world3d89.exe

demo_open_world: $(SRC) demo/demo_open_world.c
	$(CC) $(CFLAGS) $(INCLUDES) $(SRC) demo/demo_open_world.c -o demo_open_world.exe

demo_interior_portals: $(SRC) demo/demo_interior_portals.c
	$(CC) $(CFLAGS) $(INCLUDES) $(SRC) demo/demo_interior_portals.c -o demo_interior_portals.exe

run-tests: test_world3d89
	./test_world3d89.exe

clean:
	rm -f *.exe *.o
