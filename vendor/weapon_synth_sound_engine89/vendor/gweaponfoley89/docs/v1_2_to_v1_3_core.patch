+static gwf89_s16 gwf89_metal_body(gwf89_context *ctx, gwf89_s16 input)
+{
+    static const gwf89_s16 mode_weight_q15[GWF89_METAL_MODES] = {
+        10500, -9200, 7900, -6600
+    };
+    gwf89_s32 mode_sum;
+    gwf89_s32 write_value;
+    gwf89_s32 out;
+    gwf89_s16 delayed;
+    gwf89_s16 damped;
+    gwf89_s16 delta;
+    gwf89_s16 feedback;
+    gwf89_s16 excite;
+    gwf89_s16 wet;
+    unsigned short delay;
+    unsigned short read_pos;
+    unsigned int i;
+
+    /*
+       Four short, mutually inharmonic recirculating paths. White noise is
+       still the only excitation source; these paths provide the decaying
+       rigid-metal body that remains after the contact transient ends.
+       Alternating output polarities prevent the modes from collapsing into
+       a single obvious comb pitch.
+    */
+    excite = (gwf89_s16)(input >> 2);
+    mode_sum = 0L;
+
+    for (i = 0U; i < GWF89_METAL_MODES; ++i) {
+        delay = (unsigned short)ctx->preset->metal_delay[i];
+        if (delay < 2U) delay = 2U;
+        if (delay >= GWF89_METAL_BUFFER) delay = GWF89_METAL_BUFFER - 1U;
+
+        if (ctx->metal_write >= delay)
+            read_pos = (unsigned short)(ctx->metal_write - delay);
+        else
+            read_pos = (unsigned short)(GWF89_METAL_BUFFER + ctx->metal_write - delay);
+
+        delayed = ctx->metal_buffer[i][read_pos];
+        delta = gwf89_sat16((gwf89_s32)delayed - (gwf89_s32)ctx->metal_lp[i]);
+        ctx->metal_lp[i] = gwf89_sat16((gwf89_s32)ctx->metal_lp[i] +
+            (gwf89_s32)gwf89_mul_q15(ctx->preset->metal_damping_q15, delta));
+        damped = ctx->metal_lp[i];
+        feedback = gwf89_mul_q15(damped, ctx->preset->metal_feedback_q15);
+
+        if ((i & 1U) != 0U)
+            write_value = -(gwf89_s32)excite + (gwf89_s32)feedback;
+        else
+            write_value = (gwf89_s32)excite + (gwf89_s32)feedback;
+
+        ctx->metal_buffer[i][ctx->metal_write] = gwf89_sat16(write_value);
+        mode_sum += (gwf89_s32)gwf89_mul_q15(damped, mode_weight_q15[i]);
+    }
+
+    ctx->metal_write = (unsigned short)((ctx->metal_write + 1U) &
+                                        (GWF89_METAL_BUFFER - 1U));
+
+    wet = ctx->preset->metal_wet_q15;
+    out = (gwf89_s32)input + ((mode_sum * (gwf89_s32)wet) >> 15);
+    return gwf89_sat16(out);
+}
