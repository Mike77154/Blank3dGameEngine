hud custom_vector_diamond -=)
enabled true
canvas_width 300
canvas_height 30
node custom_units -=)
type bar
bind numbar.value
min_bind numbar.min
max_bind numbar.max
unit_count_bind numbar.units
pos top_left + 0,0
size 300,30
kind segmented
direction left_to_right
segments 12
segment_gap 2
frame brackets
