hud ammo_cartridges_modern -=)
enabled true
canvas_width 328
canvas_height 62

node ammo_units -=)
type bar
z 0
bind numbar.value
min_bind numbar.min
max_bind numbar.max
segments_bind numbar.segments
unit_count_bind numbar.units
radial_phase_bind numbar.phase
overlay_bind numbar.overlay
overlay_max_bind numbar.overlay_max
mid_bind numbar.mid
pos top_left + 0,0
size 328,30
kind segmented
direction right_to_left
segments 15
segment_gap 3
frame none
background solid
draw_bg false
draw_border false
draw_pattern false
draw_vector_units true
vector_ammo_indicator true
unit_renderer gproj_ammo
active_reload_visualizer true
unit_count 15
unit_padding 2
unit_scale_percent 88
unit_closed true
unit_filled true
outer_outline false
drop_shadow true
extrude false
inner_shadow false
gloss false
fill_grid false
pixel_cells false
outline_size 1
shadow_offset 1,2
color_bg #00000000
color_fill #11141800
color_lag #11141800
color_border #DDE2E8D0
color_empty #11141800
color_outline #090B0EFF
color_shadow #00000090
color_unit_fill #F2F4F6FF
color_unit_empty #59616A90
color_unit_outline #101419E8
border_size 0

node ammo_number -=)
type counter
z 2
bind numbar.value
bind2 numbar.value2
mode pair
pos top_left + 176,40
label ""
prefix ""
separator "  /  "
pad 2
pad2 3
scale 2
glyph_gap 1
color #EEF1F4F0
shadow true
shadow_color #000000B0
background false
border false
(=-
