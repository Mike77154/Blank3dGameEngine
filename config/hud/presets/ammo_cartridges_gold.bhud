hud ammo_cartridges_gold -=)
enabled true
canvas_width 300
canvas_height 46

node ammo_units -=)
type bar
z 0
bind numbar.value
min_bind numbar.min
max_bind numbar.max
segments_bind numbar.segments
unit_count_bind numbar.units
pos top_left + 0,0
size 300,18
kind segmented
direction left_to_right
segments 15
segment_gap 2
frame brackets
frame_depth 3
frame_gap 2
frame_corner 5
background diagonal
bg_step 8
bg_size 2
draw_bg true
draw_border true
draw_pattern true
draw_vector_units true
unit_shape bullet
unit_count 15
unit_padding 1
unit_scale_percent 72
unit_closed true
unit_filled true
outer_outline true
drop_shadow true
extrude true
inner_shadow true
gloss true
fill_grid true
pixel_cells true
outline_size 2
shadow_offset 3,4
extrude_depth 3
gloss_percent 28
pattern_kind vertical_stripes
pattern_step 5
pattern_size 1
color_bg #121006D8
color_fill #E8C84AFF
color_lag #A08030FF
color_border #FFF0A0FF
color_empty #302A18E0
color_pattern #FFF0A080
color_outline #080600F0
color_highlight #FFF8C080
color_shadow #000000A0
color_extrude #382A08D0
color_gloss #FFFFFF50
color_bg_detail #80682050
color_unit_fill #FFF0A0FF
color_unit_empty #5A491CC0
color_unit_outline #160F03FF
border_size 1

node ammo_number -=)
type counter
z 1
bind numbar.value
bind2 numbar.value2
mode pair
pos top_left + 190,22
label AMMO
prefix " "
separator /
pad 2
pad2 3
scale 2
glyph_gap 1
color #F4DA68FF
shadow true
shadow_color #000000D0
background false
border false
(=-
